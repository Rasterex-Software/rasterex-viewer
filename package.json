{
  "name": "@rasterex/viewer",
  "version": "2.2.2",
  "description": "Embed DWG, DXF, DGN, IFC and PDF viewing, markup, measurement and revision comparison in your web app. TypeScript SDK for the self-hosted Rasterex engine, with a hosted sandbox for evaluation.",
  "author": {
    "name": "Rasterex Software AS",
    "url": "https://rasterex.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rasterex-Software/rasterex-viewer.git"
  },
  "homepage": "https://docs.rasterex.com/docs/getting-started/quick-start",
  "bugs": {
    "url": "https://github.com/Rasterex-Software/rasterex-viewer/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo-presets": {
      "types": "./dist/demo-presets.d.ts",
      "import": "./dist/demo-presets.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.json",
    "test": "node --test test/*.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run check:versions && npm run build && npm test && npm run check:source-lines && npm run check:package",
    "check:source-lines": "node scripts/check-source-line-limit.mjs",
    "test:evaluation": "npm run build && node --test test/evaluation.test.mjs",
    "dev": "vite examples/vanilla"
  },
  "keywords": [
    "dwg-viewer",
    "dxf-viewer",
    "dgn-viewer",
    "ifc-viewer",
    "pdf-viewer",
    "cad-viewer",
    "bim-viewer",
    "drawing-comparison",
    "revision-comparison",
    "markup",
    "annotation",
    "measurement",
    "takeoff",
    "self-hosted",
    "on-premises",
    "embedded-viewer",
    "typescript",
    "react",
    "angular",
    "vue"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^8.0.16"
  }
}
