{
  "name": "@rasterex/viewer",
  "version": "2.2.3",
  "description": "Framework-independent TypeScript SDK for embedding Rasterex Canvas in web applications. Supports DWG, DXF, DGN, IFC, and PDF workflows with typed APIs for documents, tools, markup, measurement, collaboration, and drawing comparison.",
  "author": {
    "name": "Rasterex Software AS",
    "url": "https://rasterex.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rasterex-Software/rasterex-viewer.git"
  },
  "homepage": "https://docs.rasterex.com/docs/getting-started/quick-start",
  "bugs": {
    "url": "https://github.com/Rasterex-Software/rasterex-viewer/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo-presets": {
      "types": "./dist/demo-presets.d.ts",
      "import": "./dist/demo-presets.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.json",
    "test": "node --test test/*.mjs",
    "check:metadata": "node scripts/check-package-metadata.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm run check:versions && npm run check:metadata && npm run build && npm test && npm run check:source-lines && npm run check:package",
    "check:source-lines": "node scripts/check-source-line-limit.mjs",
    "test:evaluation": "npm run build && node --test test/evaluation.test.mjs",
    "dev": "vite examples/vanilla"
  },
  "keywords": [
    "rasterex",
    "rasterex-viewer",
    "rasterex-canvas",
    "rasterex-sdk",
    "document-viewer",
    "technical-document-viewer",
    "iframe-sdk",
    "iframe-viewer",
    "iframe-embed",
    "embedded-viewer",
    "self-hosted",
    "on-premises",
    "postmessage",
    "cad",
    "cad-viewer",
    "dwg",
    "dwg-viewer",
    "dxf",
    "dxf-viewer",
    "dgn",
    "dgn-viewer",
    "ifc",
    "ifc-viewer",
    "pdf",
    "pdf-viewer",
    "bim-viewer",
    "technical-drawing-viewer",
    "engineering-document-viewer",
    "construction-document-viewer",
    "plan-review",
    "markup",
    "redline",
    "annotation",
    "measurement",
    "measurement-viewer",
    "takeoff",
    "takeoff-viewer",
    "drawing-comparison",
    "document-comparison",
    "compare-viewer",
    "comparison-viewer",
    "overlay-comparison",
    "revision-comparison",
    "revision-viewer",
    "alignment-viewer",
    "collaboration",
    "typescript",
    "react",
    "angular",
    "vue"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^8.0.16"
  }
}
