{
  "name": "@rasterex/viewer",
  "version": "1.1.1",
  "description": "TypeScript SDK for embedding Rasterex Canvas in web applications via iframe and PostMessage. Built for customer self-hosted deployments; hosted Canvas is available for evaluation and proof-of-concept testing.",
  "author": {
    "name": "Rasterex Software AS",
    "url": "https://rasterex.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rasterex-Software/rasterex-viewer.git"
  },
  "homepage": "https://docs.rasterex.com/",
  "bugs": {
    "url": "https://github.com/Rasterex-Software/rasterex-viewer/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "sideEffects": false,
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo-presets": {
      "types": "./dist/demo-presets.d.ts",
      "import": "./dist/demo-presets.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.json",
    "check:source-lines": "node scripts/check-source-line-limit.mjs",
    "dev": "vite examples/vanilla"
  },
  "keywords": [
    "rasterex",
    "rasterex-viewer",
    "rasterex-canvas",
    "rasterex-sdk",
    "document-viewer",
    "technical-document-viewer",
    "iframe-sdk",
    "iframe-viewer",
    "iframe-embed",
    "embedded-viewer",
    "self-hosted",
    "on-premises",
    "postmessage",
    "cad-viewer",
    "construction-document-viewer",
    "construction-takeoff",
    "cost-estimation",
    "dwg-viewer",
    "dxf-viewer",
    "engineering-document-viewer",
    "estimation",
    "pdf-viewer",
    "measurement",
    "measurement-viewer",
    "annotation",
    "annotations",
    "alignment-viewer",
    "markup",
    "collaboration",
    "bim-viewer",
    "ifc-viewer",
    "plan-review",
    "compare-viewer",
    "comparison-viewer",
    "document-comparison",
    "drawing-comparison",
    "overlay-comparison",
    "revision-comparison",
    "revision-viewer",
    "takeoff-viewer",
    "technical-drawing-viewer"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^8.0.16"
  }
}
